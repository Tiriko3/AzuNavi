{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AzuNavi",
  "version": "1.6.0",
  "identifier": "com.local.personaapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AzuNavi",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 450,
        "center": true,
        "resizable": true,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "AzuNavi",
    "copyright": "AzuNavi – private Nutzung",
    "shortDescription": "AzuNavi – dein Navigator durch die Ausbildung",
    "longDescription": "Notizen, Kontakte, Projekte, Dateien und Berichtsheft für Azubis – lokal auf deinem Rechner.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "AzuNavi"
}
