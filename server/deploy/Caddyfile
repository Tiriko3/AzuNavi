# ENTWURF. Zertifikate liegen in deploy/certs (siehe make-test-certs.sh), kein automatisches Internet-Zertifikat.
{
	admin off
	auto_https off
}

:443 {
	tls /certs/server.crt /certs/server.key {
		protocols tls1.3
	}
	request_body {
		max_size 5MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Nur die bekannten Pfade durchlassen, alles andere endet hier
	@api path /healthz /v1/*
	handle @api {
		reverse_proxy azunavi:8080 {
			header_up X-Real-IP {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
	handle {
		respond 404
	}
	# Kein Zugriffsprotokoll: Anfragen enthalten Benutzernamen (prelogin) und Adressen.
}
